+// Mirror-camera exemption.
+// Set while a via.render.layer.Scene that carries a via.render.Mirror is inside its update() or draw()
+// on this thread (see begin_mirror_layer_window / end_mirror_layer_window). RE8's scope mirror layer
+// renders with the MAIN camera object (same address), so the camera argument of the getters cannot
+// tell the mirror pass from the main pass; the window can. praydog's RE4 ScopeCamera exemption below
+// keys on the camera's GameObject name instead, which only works when the scope has its own camera.
+static thread_local sdk::renderer::layer::Scene* s_mirror_layer_active{nullptr};
+
+// ---------------------------------------------------------------------------------------------
+// MIRROR PROJECTION STEERING  (dossier §9aq fix (1b))
+//
+// The scope's mirror pass is handed the HMD EYE's projection (90.88° across, off-centre by
+// m20=+0.1736 / m21=-0.2111), not its own 59.41° one. The plugin then crops a small window out of
+// that frame and follows the bore with it; past ~38.71° on one side and ~49.09° on the other the
+// crop centre runs off the edge of the frame and clamps, which is the smear.
+//
+// Widening the frame fixes it and costs sharpness (83 % at 44°, 67 % at 50°). STEERING it costs
+// nothing: an off-centre shift moves WHICH cone is drawn without widening it, so pixels-per-degree
+// are unchanged and the crop sits dead centre at every angle, i.e. it can never clamp.
+//
+//   NDC x = m00 * tan(t) + m20        ->    m20 = -m00 * tan(bore_yaw)   puts the bore at NDC 0
+//   NDC y = m11 * tan(t) + m21        ->    m21 = -m11 * tan(bore_pitch)
+//
+// [verified-numerically 2026-09-19] (plugin/tools/mirror_fov_check.cpp, 20 checks, 0 failed) --
+// but the matrices behind it are n=1 [verified-live 2026-09-12] and the SIGN of that relation was
+// read off a Lua dump rather than derived from RE Engine's clip convention. See the warning in
+// steer_mirror_projection(); the flat sweep is what settles it.
+//
+// Off by default. The exemption toggles above are a DIFFERENT and, for the smear, backwards fix --
+// they restore the mirror's own narrower projection and make the clamp happen 15.73° a side sooner.
+// ---------------------------------------------------------------------------------------------
+
+// tan() runs away near 90° and the frustum is unusable long before that. Named rather than written
+// inline so the one place it is enforced is greppable.
+static constexpr float kMirrorSteerLimitDeg = 75.0f;
+// How often the steering path writes a progress line, in projection calls.
+static constexpr uint32_t kMirrorSteerLogEvery = 600;
+// Shout mode multiplies the projection's half-extents by this. 0.5 doubles the field of view,
+// which is far too big to mistake for anything else.
+static constexpr float kMirrorShoutScale = 0.5f;
+
+// Set by REF_SetMirrorSteerAngles() from the scope plugin (same process, different DLL), read on
+// the render thread -> atomics. Degrees, camera-relative: +yaw right, +pitch up.
+static std::atomic<float> s_plugin_steer_yaw_deg{0.0f};
+static std::atomic<float> s_plugin_steer_pitch_deg{0.0f};
+// Mirrors m_steer_mirror_projection so the exported query below needs no access to the VR mod.
+static std::atomic<bool> s_mirror_steer_enabled{false};
+
+// Exported so the scope plugin can hand over the real bore angle it already computes, without
+// either side needing a REFramework API change: GetModuleHandleW(L"dinput8.dll") +
+// GetProcAddress("REF_SetMirrorSteerAngles"). Ignored unless "steer from plugin" is ticked.
+extern "C" __declspec(dllexport) void REF_SetMirrorSteerAngles(float yaw_deg, float pitch_deg) {
+    s_plugin_steer_yaw_deg.store(yaw_deg, std::memory_order_relaxed);
+    s_plugin_steer_pitch_deg.store(pitch_deg, std::memory_order_relaxed);
+}
+
+// Lets the plugin switch its crop to mode 2 (take the texture centre) only when steering is really
+// on, instead of the same fact being written into two config files that can disagree.
+extern "C" __declspec(dllexport) int REF_MirrorSteerIsEnabled() {
+    return s_mirror_steer_enabled.load(std::memory_order_relaxed) ? 1 : 0;
+}
+
+// re-village-scope-vr, 2026-09-22: THE POSE THE MIRROR IS DRAWN FROM, handed to the scope plugin.
+// With plan C on, the mirror layer renders from the game's OWN camera pose (m_original_camera_matrix);
+// with it off, from the headset pose REFramework wrote into the camera joint (m_render_camera_matrix).
+// The plugin places its crosshair with the pose it reads off the camera joint on the game thread, and
+// nothing ever told it which of the two the picture was really drawn with -- the difference between
+// them is a crosshair error that turns with posture, which is what a hand-tuned "zero" has been
+// covering. Published on every mirror window; gen advances each time so staleness is visible.
+//   out16: the world matrix (column-major, translation in [12..14]); kind: 1 = game's own camera
+//   (plan C), 2 = headset pose. Returns 0 when nothing has been published yet.
+static std::mutex s_mirror_draw_pose_mu;
+static Matrix4x4f s_mirror_draw_pose{glm::identity<Matrix4x4f>()};
+static int s_mirror_draw_pose_kind{0};
+static uint32_t s_mirror_draw_pose_gen{0};
+
+static void publish_mirror_draw_pose(const Matrix4x4f& pose, int kind) {
+    std::lock_guard<std::mutex> lk{s_mirror_draw_pose_mu};
+    s_mirror_draw_pose = pose;
+    s_mirror_draw_pose_kind = kind;
+    ++s_mirror_draw_pose_gen;
+}
+
+extern "C" __declspec(dllexport) int REF_GetMirrorDrawPose(float* out16, int* out_kind, unsigned* out_gen) {
+    std::lock_guard<std::mutex> lk{s_mirror_draw_pose_mu};
+    if (s_mirror_draw_pose_kind == 0) {
+        return 0;
+    }
+    if (out16 != nullptr) {
+        const float* m = &s_mirror_draw_pose[0][0];
+        for (int i = 0; i < 16; ++i) {
+            out16[i] = m[i];
+        }
+    }
+    if (out_kind != nullptr) {
+        *out_kind = s_mirror_draw_pose_kind;
+    }
+    if (out_gen != nullptr) {
+        *out_gen = s_mirror_draw_pose_gen;
+    }
+    return 1;
+}
