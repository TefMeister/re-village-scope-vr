+void VR::begin_mirror_layer_window(sdk::renderer::layer::Scene* layer, const char* phase) {
+    if (layer == nullptr) {
+        return;
+    }
+
+    const auto mirror = layer->get_mirror();
+
+    if (mirror == nullptr) {
+        // Sticky mode: a non-mirror layer starting is what closes the window.
+        s_mirror_layer_active = nullptr;
+        return;
+    }
+
+    s_mirror_layer_active = layer;
+    const auto windows = m_mirror_exemption.windows_seen.fetch_add(1, std::memory_order_relaxed) + 1;
+
+    // Published for REF_MirrorSteerIsEnabled(); refreshed here because this already runs every
+    // frame the mirror draws and so needs no extra hook.
+    s_mirror_steer_enabled.store(m_steer_mirror_projection->value(), std::memory_order_relaxed);
+
+    const auto camera = layer->get_camera();
+    const auto primary = sdk::get_primary_camera();
+    // (v2) no camera-address recording: exempting by camera identity hit the multipass duplicate eye camera.
+
+    // One-time sighting log, then two progress lines so a flat (non-VR) run can tell whether the
+    // camera getters are called inside the window at all.
+    if (!m_mirror_exemption.logged_layer.exchange(true)) {
+        std::wstring_view go_name{L""};
+
+        if (camera != nullptr) {
+            if (const auto go = utility::re_component::get_game_object((REComponent*)camera); go != nullptr) {
+                go_name = utility::re_string::get_view(go->name);
+            }
+        }
+
+        spdlog::info("[VR] Mirror-bearing scene layer seen ({}): layer={:x} mirror={:x} camera={:x} primary={:x} camera_is_primary={} camera_go=\"{}\" exempt_enabled={} sticky={}",
+            phase, (uintptr_t)layer, (uintptr_t)mirror, (uintptr_t)camera, (uintptr_t)primary, camera == primary, utility::narrow(go_name), m_exempt_mirror_cameras->value(), m_exempt_mirror_cameras_sticky->value());
+    }
+
+    if (windows % 600 == 0 && windows <= 3600) {
+        spdlog::info("[VR] Mirror window: camera view un-HMD'd {} times, skipped {} (no original pose), plan C enabled={}",
+            m_mirror_exemption.view_unhmd.load(), m_mirror_exemption.view_unhmd_skipped.load(), m_mirror_uses_original_camera->value());
+    }
+
+    if (windows == 120 || windows == 1200) {
+        spdlog::info("[VR] Mirror layer windows={} get_ProjectionMatrix calls inside={} get_ViewMatrix calls inside={} exempted proj={} view={} (by window={} camera={} name={}) hmd_active={}",
+            windows,
+            m_mirror_exemption.proj_calls_in_window.load(), m_mirror_exemption.view_calls_in_window.load(),
+            m_mirror_exemption.proj_exempted.load(), m_mirror_exemption.view_exempted.load(),
+            m_mirror_exemption.exempted_by_window.load(), m_mirror_exemption.exempted_by_camera.load(), m_mirror_exemption.exempted_by_name.load(),
+            is_hmd_active());
+    }
+}
+
+void VR::end_mirror_layer_window(sdk::renderer::layer::Scene* layer) {
+    if (m_exempt_mirror_cameras_sticky->value()) {
+        return; // closed by the next non-mirror layer's begin instead
+    }
+
+    if (s_mirror_layer_active != nullptr && s_mirror_layer_active == layer) {
+        s_mirror_layer_active = nullptr;
+    }
+}
+
+bool VR::is_camera_exempt(REManagedObject* camera, bool projection) {
+    if (!m_exempt_mirror_cameras->value()) {
+        return false;
+    }
+
+    auto count = [&]() {
+        (projection ? m_mirror_exemption.proj_exempted : m_mirror_exemption.view_exempted).fetch_add(1, std::memory_order_relaxed);
+    };
+
+    // 1. A mirror-bearing scene layer is updating/drawing on this thread (RE8: shared main camera).
+    if (s_mirror_layer_active != nullptr) {
+        m_mirror_exemption.exempted_by_window.fetch_add(1, std::memory_order_relaxed);
+        count();
+        return true;
+    }
+
+    if (camera == nullptr) {
+        return false;
+    }
+
+    // 2. (v2) camera-identity stage removed on purpose; exempted_by_camera stays 0.
+
+    // 3. Name prefix on the camera's GameObject, the way praydog exempted RE4's ScopeCamera.
+    if (const auto go = utility::re_component::get_game_object((REComponent*)camera); go != nullptr) {
+        const auto name = utility::re_string::get_view(go->name);
+
+        static const std::vector<std::wstring> exempt_prefixes = {
+            L"ScopeCamera",
+            L"MirrorCamera",
+            L"ScopeMirror",
+        };
+
+        for (const auto& prefix : exempt_prefixes) {
+            if (name.starts_with(prefix)) {
+                m_mirror_exemption.exempted_by_name.fetch_add(1, std::memory_order_relaxed);
+                count();
+                return true;
+            }
+        }
+    }
+
+    return false;
+}
