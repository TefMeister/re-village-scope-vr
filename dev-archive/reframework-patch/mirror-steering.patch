+void VR::steer_mirror_projection(Matrix4x4f* result) {
+    // Base matrix. In VR this is the eye projection the mirror pass would have been given anyway,
+    // so the drawn cone keeps the 90.88° width every number in §9aq was derived against. Flat (no
+    // headset), or when "steer the native projection" is ticked, it is the game's own projection --
+    // which the original getter has already written into *result before this callback runs
+    // (Hooks::camera_get_projection_matrix_hook_internal calls original() first).
+    Matrix4x4f proj = *result;
+
+    const bool have_eye_projection = is_hmd_active() && !m_disable_projection_matrix_override;
+    const bool from_native = m_steer_mirror_from_native->value() || !have_eye_projection;
+
+    if (!from_native) {
+        proj = get_current_projection_matrix(false);
+    }
+
+    float yaw_deg = m_mirror_steer_yaw->value();
+    float pitch_deg = m_mirror_steer_pitch->value();
+
+    if (m_mirror_steer_from_plugin->value()) {
+        yaw_deg = s_plugin_steer_yaw_deg.load(std::memory_order_relaxed);
+        pitch_deg = s_plugin_steer_pitch_deg.load(std::memory_order_relaxed);
+    }
+
+    yaw_deg = glm::clamp(yaw_deg, -kMirrorSteerLimitDeg, kMirrorSteerLimitDeg);
+    pitch_deg = glm::clamp(pitch_deg, -kMirrorSteerLimitDeg, kMirrorSteerLimitDeg);
+
+    // glm is column-major and Matrix4x4f is a glm::mat4, so proj[2][0] is the element the dossier
+    // calls m20 -- the same one the 2026-09-12 Lua probe read as m[2].x. m00/m11 are deliberately
+    // left alone: not widening is the whole point of steering.
+    //
+    // !! THE SIGN IS NOT PROVEN. "NDC = m00*tan(t) + m20" is how §9aq states it, which gives the
+    // minus below; the opposite convention ("- m20") is equally common and would steer the frame the
+    // WRONG WAY -- the crop would run off the edge twice as fast instead of staying centred. That
+    // shows up in the first seconds of the flat sweep and is cured by ticking Invert. Until the
+    // sweep has been read, treat the sign as [hypothesis], not as settled.
+    const float sign = m_mirror_steer_invert->value() ? 1.0f : -1.0f;
+
+    const float shift_x = sign * proj[0][0] * std::tan(glm::radians(yaw_deg));
+    const float shift_y = sign * proj[1][1] * std::tan(glm::radians(pitch_deg));
+
+    const float was_x = proj[2][0];
+    const float was_y = proj[2][1];
+
+    proj[2][0] = shift_x;
+    proj[2][1] = shift_y;
+
+    *result = proj;
+
+    const auto n = m_mirror_exemption.proj_steered.fetch_add(1, std::memory_order_relaxed) + 1;
+
+    if (n == 1 || n % kMirrorSteerLogEvery == 0) {
+        spdlog::info("[VR] Mirror steering #{}: base={} yaw={:.2f} pitch={:.2f} deg (source={}) "
+                     "m00={:.4f} m11={:.4f} m20 {:+.4f}->{:+.4f} m21 {:+.4f}->{:+.4f} invert={} hmd={}",
+            n, from_native ? "native" : "eye", yaw_deg, pitch_deg,
+            m_mirror_steer_from_plugin->value() ? "plugin" : "slider",
+            proj[0][0], proj[1][1], was_x, shift_x, was_y, shift_y,
+            m_mirror_steer_invert->value(), is_hmd_active());
+    }
+}
