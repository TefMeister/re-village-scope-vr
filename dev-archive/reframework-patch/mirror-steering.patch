+    if (s_mirror_layer_active != nullptr && m_steer_mirror_projection->value()) {
+        steer_mirror_projection(result);
+        return;
+    }
+
+    if (!is_hmd_active() || m_disable_projection_matrix_override) {
         return;
     }
 
