@@ -359,6 +362,33 @@ void RE8VR::update_hand_ik() {
 
             auto grip_rot_delta = glm::normalize(current_grip_rot * glm::inverse(original_grip_rot));
 
+            // re-village-scope-vr, 2026-09-21: THE GRIP MUST NOT THROW THE GUN.
+            // The grip engages anywhere within 10 cm of the socket, and the line above then
+            // re-aims the gun along the REAL hand-to-hand line at once -- up to ~16 deg with the
+            // hands 35 cm apart. Tefa: "the weapon throwing to the left visibly after putting
+            // hand on the gun". So the rotation present at the moment the grip is taken is
+            // remembered and removed: taking the grip changes nothing, and only what the left
+            // hand does AFTERWARDS steers. It is kept in the gun's own frame so that turning the
+            // whole body does not bring it back. A reload ends the grip, so the hand coming back
+            // after one is a fresh take and does not throw either.
+            // m_grip_relative = false restores praydog's original behaviour for an A/B.
+            if (!m_grip_steering_active) {
+                m_grip_engage_delta_local = glm::normalize(glm::inverse(rh_rotation) * grip_rot_delta * rh_rotation);
+                m_grip_steering_active = true;
+                ++m_grip_engage_count;
+
+                const auto w = glm::clamp(glm::abs(grip_rot_delta.w), 0.0f, 1.0f);
+                m_grip_last_engage_deg = glm::degrees(2.0f * std::acos(w));
+                spdlog::info("[RE8VR] grip taken #{}: the hands' line was {:.2f} deg off the gun -- {}",
+                    m_grip_engage_count, m_grip_last_engage_deg,
+                    m_grip_relative ? "REMOVED, the gun does not move" : "APPLIED at once (original behaviour)");
+            }
+
+            if (m_grip_relative) {
+                const auto engage_delta_world = glm::normalize(rh_rotation * m_grip_engage_delta_local * glm::inverse(rh_rotation));
+                grip_rot_delta = glm::normalize(grip_rot_delta * glm::inverse(engage_delta_world));
+            }
+
             // Adjust the right hand rotation;
             rh_rotation = glm::normalize(grip_rot_delta * rh_rotation);
 
