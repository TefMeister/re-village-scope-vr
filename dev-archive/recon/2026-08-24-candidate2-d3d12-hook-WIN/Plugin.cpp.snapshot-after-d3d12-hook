// re-scope-vr — REFramework native plugin for a real VR sniper scope in RE Engine games.
//
// M2b step 1: the lens rides the rifle. A game-thread tick (BeginRendering)
// resolves the primary camera's pose and the equipped weapon's Body joint via
// the reflection SDK, projects the joint with our own pinhole math, and hands
// the render thread a lens rect through atomics. The composite draws the lens
// there (corner fallback while unresolved), and the crop follows the lens so
// it behaves like a magnifier held over the rifle.
//
// M2a: digital-zoom scope image.
// Every frame at present time: copy the completed backbuffer into our own capture
// texture, draw a magnified crop of it into our 320x240 render target through a
// textured-quad pipeline (root signature + embedded HLSL + PSO), then composite that
// RT into the backbuffer corner (M1 path). The corner box becomes a live 2.6x
// magnified view — the scope image exists. Crop center is a parameter (root
// constants) so the aim-point-projected center can drive it later.
//
// Written from scratch against the published REFramework plugin SDK (include/reframework/API.h).

#include <windows.h>
#include <d3d12.h>
#include <dxgi1_4.h>
#include <d3dcompiler.h>
#include <wrl/client.h>

#include <atomic>
#include <cmath>
#include <cstdint>
#include <cstring>

